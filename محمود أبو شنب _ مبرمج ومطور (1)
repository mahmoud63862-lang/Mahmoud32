:root { --bg: #080b18; --panel: rgba(18,26,51,.88); --text: #f1f5ff; --muted: #a4afcb; --border: #839bff35; --cyan: #36e3f5; --blue: #5b8cff; --purple: #a477ff; --shadow: 0 20px 55px #0003; }

body.light { --bg: #f3f6ff; --panel: rgba(255,255,255,.92); --text: #17213d; --muted: #5c6784; --border: #5b8cff38; --shadow: 0 18px 45px #263b7012; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; scroll-padding-top: 85px; }

body { font-family: Cairo, sans-serif; background: var(--bg); color: var(--text); line-height: 1.8; transition: background 0.3s, color 0.3s; overflow-x: hidden; }

body.en { font-family: Inter, sans-serif; }

a { color: inherit; text-decoration: none; }

button, input, textarea { font: inherit; }

button { cursor: pointer; }

.container { width: min(1120px, 91%); margin: auto; }

#particles { position: fixed; inset: 0px; width: 100%; height: 100%; z-index: -2; pointer-events: none; }

.glow { position: fixed; width: 300px; height: 300px; filter: blur(100px); opacity: 0.15; border-radius: 50%; z-index: -1; pointer-events: none; }

.glow.one { background: var(--blue); top: -100px; right: -100px; }

.glow.two { background: var(--purple); bottom: 0px; left: -100px; }

header { position: sticky; top: 0px; z-index: 20; background: color-mix(in srgb,var(--bg) 88%,transparent); backdrop-filter: blur(18px); border-bottom: 1px solid var(--border); }

.nav { min-height: 75px; display: flex; justify-content: space-between; align-items: center; gap: 15px; }

.logo { font-family: Inter, sans-serif; font-weight: 900; font-size: 20px; white-space: nowrap; }

.logo span { color: var(--cyan); }

.nav-links { display: flex; gap: 17px; align-items: center; }

.nav-links a { font-size: 12px; color: var(--muted); font-weight: 700; }

.nav-links a:hover { color: var(--cyan); }

.actions { display: flex; gap: 7px; }

.icon-btn { border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 12px; padding: 7px 12px; }

.icon-btn:hover { border-color: var(--cyan); }

.hero { min-height: 610px; display: grid; grid-template-columns: 1.2fr 0.8fr; align-items: center; gap: 35px; padding-top: 55px; padding-bottom: 65px; }

.eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 7px 13px; border: 1px solid var(--border); border-radius: 30px; color: var(--cyan); background: var(--panel); font-size: 12px; margin-bottom: 22px; }

.status-dot { width: 8px; height: 8px; border-radius: 50%; background: rgb(76, 230, 165); box-shadow: rgb(76, 230, 165) 0px 0px 12px; }

h1 { font-size: clamp(38px, 5.5vw, 65px); line-height: 1.25; margin-bottom: 17px; }

body.en h1 { font-family: Inter, sans-serif; letter-spacing: -2px; direction: ltr; }

.gradient { display: block; background-image: ; background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-size: 200% auto; background-clip: text; color: transparent; animation: 5s linear 0s infinite normal none running shine; }

@keyframes shine { 
  100% { background-position: 200% center; }
}

.hero h2 { font-size: 20px; margin-bottom: 12px; }

p { color: var(--muted); font-size: 14px; line-height: 2; }

.hero p { max-width: 580px; }

.buttons { display: flex; gap: 11px; flex-wrap: wrap; margin-top: 24px; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 19px; border-radius: 12px; border: 1px solid var(--border); font-size: 13px; font-weight: 800; transition: 0.25s; }

.primary { background: linear-gradient(110deg,var(--cyan),#8caaff); color: rgb(8, 17, 30); border: 0px; }

.secondary { background: var(--panel); }

.btn:hover { transform: translateY(-4px); }

.tech-row { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 25px; }

.tech { display: grid; place-items: center; width: 43px; height: 43px; border: 1px solid var(--border); border-radius: 13px; background: var(--panel); font-size: 19px; }

.signature { font: 11px Inter, sans-serif; letter-spacing: 2px; color: var(--muted); margin-top: 22px; }

.visual { position: relative; display: grid; place-items: center; min-height: 370px; }

.orbit { position: absolute; width: 290px; height: 290px; border: 1px solid rgba(91, 140, 255, 0.333); border-radius: 50%; animation: 24s linear 0s infinite normal none running spin; }

.orbit::before, .orbit::after { content: ""; position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 20px var(--cyan); }

.orbit::before { top: 35px; left: 35px; }

.orbit::after { bottom: 30px; right: 25px; background: var(--purple); box-shadow: 0 0 20px var(--purple); }

.orbit.small { width: 220px; height: 220px; animation-direction: reverse; animation-duration: 17s; }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

.profile-card { width: 230px; padding: 18px; border: 1px solid var(--border); border-radius: 24px; background: var(--panel); box-shadow: var(--shadow); z-index: 2; animation: 5s ease-in-out 0s infinite normal none running float; text-align: center; }

@keyframes float { 
  50% { transform: translateY(-10px); }
}

.avatar { width: 185px; height: 215px; margin: auto auto 15px; border-radius: 18px; overflow: hidden; border: 1px solid var(--border); background: linear-gradient(135deg, rgb(20, 40, 75), rgb(40, 33, 75)); display: grid; place-items: center; color: var(--cyan); font: 800 44px Inter, sans-serif; }

.avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

.profile-caption { font-size: 12px; color: var(--muted); }

.tag { position: absolute; padding: 9px 12px; border: 1px solid var(--border); background: var(--panel); border-radius: 12px; font-size: 11px; font-weight: 800; z-index: 3; }

.tag.one { top: 25px; right: 0px; color: var(--cyan); }

.tag.two { bottom: 20px; left: 0px; color: var(--purple); }

section { padding: 70px 0px; }

.heading { margin-bottom: 28px; }

.kicker { font-size: 12px; font-weight: 900; color: var(--cyan); letter-spacing: 1px; }

.heading h2 { font-size: clamp(25px, 4vw, 36px); margin-top: 7px; line-height: 1.5; }

.heading p { margin-top: 8px; max-width: 700px; }

.grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 17px; }

.panel { padding: 23px; border: 1px solid var(--border); border-radius: 19px; background: var(--panel); box-shadow: var(--shadow); transition: 0.3s; min-width: 0px; }

.panel:hover { transform: translateY(-5px); border-color: rgba(54, 227, 245, 0.467); }

.card-icon { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 14px; background: linear-gradient(135deg, rgba(54, 227, 245, 0.11), rgba(164, 119, 255, 0.125)); font-size: 22px; margin-bottom: 15px; }

.panel h3 { font-size: 17px; margin-bottom: 8px; }

.panel p { font-size: 13px; }

.chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 15px; }

.chip { font-size: 10px; font-weight: 800; padding: 4px 9px; border: 1px solid var(--border); border-radius: 8px; color: var(--cyan); }

.project { display: flex; flex-direction: column; min-height: 260px; }

.project .bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 18px; font-size: 11px; color: var(--purple); }

.skill-bar { height: 6px; border-radius: 20px; background: var(--border); overflow: hidden; margin-top: 15px; }

.skill-bar span { display: block; height: 100%; background: linear-gradient(90deg,var(--cyan),var(--purple)); border-radius: 20px; }

.learning { padding: 27px; border: 1px solid var(--border); border-radius: 20px; background: linear-gradient(125deg, rgba(91, 140, 255, 0.075), rgba(164, 119, 255, 0.063), rgba(54, 227, 245, 0.03)); }

.learning h3 { font-size: 20px; margin-bottom: 10px; }

.goal-list { display: grid; gap: 12px; margin-top: 18px; }

.goal { display: flex; gap: 10px; color: var(--muted); font-size: 13px; }

.check { color: var(--cyan); font-weight: 900; }

.lab-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0px; }

.lab-tab { border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; color: var(--muted); background: transparent; font-size: 12px; }

.lab-tab.active { background: var(--cyan); color: rgb(7, 17, 30); border-color: var(--cyan); }

.lab-screen { direction: ltr; text-align: left; white-space: pre-wrap; overflow-wrap: anywhere; background: rgb(6, 10, 20); color: rgb(216, 228, 255); border: 1px solid var(--border); border-radius: 13px; padding: 20px; font: 13px / 2 monospace; min-height: 110px; }

.certificate { display: flex; flex-direction: column; }

.certificate img { width: 100%; height: 190px; object-fit: contain; background: rgb(255, 255, 255); border-radius: 12px; margin-bottom: 15px; }

.certificate-placeholder { height: 190px; display: grid; place-items: center; background: linear-gradient(135deg, rgb(20, 40, 75), rgb(40, 33, 75)); border: 1px dashed var(--border); border-radius: 12px; margin-bottom: 15px; font-size: 45px; }

.contact { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 18px; }

.email { display: inline-block; direction: ltr; color: var(--cyan); font: 13px Inter, sans-serif; overflow-wrap: anywhere; margin-top: 12px; }

.form { display: grid; gap: 12px; }

.field { display: grid; gap: 6px; }

.field label { font-size: 12px; font-weight: 800; }

.field input, .field textarea { width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg); color: var(--text); outline: none; }

.field input:focus, .field textarea:focus { border-color: var(--cyan); }

.field textarea { min-height: 110px; resize: vertical; }

footer { padding: 25px 0px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); }

.footer-inner { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

.reveal { opacity: 0; transform: translateY(18px); transition: 0.7s; }

.reveal.visible { opacity: 1; transform: translateY(0px); }

.back-top { position: fixed; bottom: 18px; left: 18px; width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 13px; background: var(--panel); color: var(--cyan); z-index: 5; }

@media (max-width: 900px) {
  .nav-links { gap: 10px; }
  .nav-links a { font-size: 11px; }
  .hero { grid-template-columns: 1fr; gap: 10px; }
  .visual { min-height: 360px; }
  .contact { grid-template-columns: 1fr; }
  .grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
}

@media (max-width: 650px) {
  .nav { min-height: 65px; }
  .nav-links { display: none; }
  .logo { font-size: 16px; }
  .hero { padding-top: 40px; gap: 10px; }
  .hero h1 { font-size: clamp(34px, 10vw, 47px); }
  .hero h2 { font-size: 17px; }
  .hero p { font-size: 13px; }
  .visual { min-height: 330px; }
  .orbit { width: 260px; height: 260px; }
  .orbit.small { width: 205px; height: 205px; }
  section { padding: 52px 0px; }
  .grid { grid-template-columns: 1fr; }
  .panel { padding: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation: auto ease 0s 1 normal none running none !important; scroll-behavior: auto !important; transition: none !important; }
}
